<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="farm_ground">
    <static>true</static>
    <link name="ground_link">
      <visual name="ground_visual">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>50 50</size>
          </plane>
        </geometry>
        <material>
          <script>
            <uri>model://farm_ground/materials/scripts</uri>
            <uri>model://farm_ground/materials/textures</uri>
            <name>Soil/Diffuse</name>
          </script>
        </material>
      </visual>
      <collision name="ground_collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>50 50</size>
          </plane>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
